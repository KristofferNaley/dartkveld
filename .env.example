# Tilkobling til den eksisterende Postgres-serveren.
# Verten er containernavnet til Postgres på Docker-nettverket under.
DATABASE_URL=postgres://dart:bytt-meg@postgres:5432/dart

# Docker-nettverket der Postgres-serveren ligger (må finnes fra før)
DB_NETWORK=backend

# Lag med: openssl rand -base64 32
BETTER_AUTH_SECRET=bytt-meg-til-en-lang-tilfeldig-streng

# Den offentlige adressen appen nås på (uten skråstrek til slutt)
BETTER_AUTH_URL=http://localhost:3014
APP_URL=http://localhost:3014

# Valgfritt
# APP_PORT=3014          # port på verten (bindes til 127.0.0.1)
# DISABLE_SIGNUP=true    # skru av registrering når alle i gjengen har konto
